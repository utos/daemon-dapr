<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Execution.Application/Execution.Application.csproj"/>
        <ProjectReference Include="../Execution.Infrastructure/Execution.Infrastructure.csproj"/>
        <ProjectReference Include="../../common/Common.Constants/Common.Constants.csproj"/>
        <ProjectReference Include="../../common/Common.Workflow.Proto/Common.Workflow.Proto.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Utos.Workflow" />
        <PackageReference Include="Utos.Daemon.Server" />
        <PackageReference Include="FluentValidation"/>
        <PackageReference Include="Grpc.AspNetCore" />
        <!-- google.rpc.Status details on INVALID_ARGUMENT: the schema failure list a schedule
             is refused with (UTOS-H101/H102), as api/docs/workflow-schemas.md specifies. -->
        <PackageReference Include="Google.Api.CommonProtos" />
        <PackageReference Include="Grpc.StatusProto" />
    </ItemGroup>

    <ItemGroup>
        <!-- Refuse() maps a schema failure onto google.rpc.BadRequest; the shape is asserted
             below the gRPC surface so it needs no Docker. -->
        <InternalsVisibleTo Include="UnitTests" />
        <PackageReference Include="Mediator.Abstractions" />
    </ItemGroup>

</Project>
